      "name": "Create rqst(POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));\r",
              "const jsonData = pm.response.json();\r",
              "pm.environment.set(\"gist_id\", jsonData.id);\r",
              "pm.test(\"Response has id\", () => pm.expect(jsonData.id).to.exist);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"description\": \"My test gist\", \"public\": true, \"files\": {\"test.txt\": {\"content\": \"Hello from Postman\"}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
